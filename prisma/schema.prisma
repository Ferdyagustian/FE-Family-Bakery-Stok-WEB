// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MANAGER
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String?
  role         Role     @default(MANAGER)
  storeId      String?  
  store        Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([storeId])
}

model Store {
  id        String    @id @default(cuid())
  name      String
  location      String?
  storeProducts StoreProduct[]
  sales         Sale[]
  restockRequests RestockRequest[]
  customOrders    CustomOrder[]
  returns       ProductReturn[]
  users     User[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id            String         @id @default(cuid())
  name          String
  description   String?
  imageUrl      String?
  price         Float
  discount      Int            @default(0)
  sales         Sale[]
  storeProducts StoreProduct[]
  restockRequests  RestockRequest[]
  customOrderItems CustomOrderItem[]
  returns          ProductReturn[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([name])
}

model StoreProduct {
  id            String   @id @default(cuid())
  storeId       String
  productId     String
  stockQuantity Int      @default(0)
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([storeId, productId])
  @@index([storeId])
  @@index([productId])
  @@index([stockQuantity])
}

model Sale {
  id            String   @id @default(cuid())
  storeId       String
  productId     String
  receiptNo     String?
  paymentMethod String?
  cashPaid      Float?
  change        Float?
  quantitySold  Int
  totalAmount   Float
  profitAmount  Float
  saleDate      DateTime @default(now())
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([saleDate])
  @@index([storeId])
  @@index([productId])
  @@index([storeId, saleDate])
  @@index([receiptNo])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  username   String?
  action     String
  entityType String
  entityId   String?
  entityName String?
  detail     String?
  storeId    String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([storeId])
  @@index([createdAt])
  @@index([entityType, entityId])
}

enum RestockStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  IN_PROCESS
  READY
  COMPLETED
  CANCELLED
}

model RestockRequest {
  id          String        @id @default(cuid())
  batchNo     String
  storeId     String
  productId   String
  quantity    Int
  status      RestockStatus @default(PENDING)
  notes       String?
  requestedBy String
  approvedBy  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  store       Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product     Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([storeId, status])
  @@index([batchNo])
  @@index([status])
  @@index([createdAt])
}

model CustomOrder {
  id           String            @id @default(cuid())
  orderNo      String            @unique
  customerName String
  phone        String
  pickupDate   DateTime
  storeId      String
  status       OrderStatus       @default(PENDING)
  totalAmount  Float
  depositPaid  Float             @default(0)
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  items        CustomOrderItem[]
  store        Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([pickupDate, status])
  @@index([pickupDate])
  @@index([status])
  @@index([storeId])
  @@index([createdAt])
}

model CustomOrderItem {
  id        String      @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Float

  order     CustomOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}

model ProductReturn {
  id          String   @id @default(cuid())
  storeId     String
  productId   String
  quantity    Int
  reason      String
  notes       String?
  returnedBy  String?
  returnDate  DateTime @default(now())

  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([storeId, returnDate])
  @@index([productId])
  @@index([returnDate])
}
