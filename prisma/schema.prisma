// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MANAGER
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String?
  role         Role     @default(MANAGER)
  storeId      String?  
  store        Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([storeId])
}

model Store {
  id        String    @id @default(cuid())
  name      String
  location      String?
  storeProducts StoreProduct[]
  sales         Sale[]
  users     User[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id            String         @id @default(cuid())
  name          String
  description   String?
  imageUrl      String?
  price         Float
  discount      Int            @default(0)
  sales         Sale[]
  storeProducts StoreProduct[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model StoreProduct {
  id            String   @id @default(cuid())
  storeId       String
  productId     String
  stockQuantity Int      @default(0)
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([storeId, productId])
  @@index([storeId])
  @@index([productId])
  @@index([stockQuantity])
}

model Sale {
  id            String   @id @default(cuid())
  storeId       String
  productId     String
  quantitySold  Int
  totalAmount   Float
  profitAmount  Float
  saleDate      DateTime @default(now())
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([saleDate])
  @@index([storeId])
  @@index([productId])
  @@index([storeId, saleDate])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  username   String?
  action     String
  entityType String
  entityId   String?
  entityName String?
  detail     String?
  storeId    String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([storeId])
  @@index([createdAt])
  @@index([entityType, entityId])
}
